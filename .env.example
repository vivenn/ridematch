DATABASE_URL="postgresql://vybecabs:vybecabs@localhost:5432/vybecabs?schema=public"
REDIS_URL="redis://localhost:6379"
PORT=3000

# how long (ms) drivers get to respond to a ride offer before we retry with the next batch
RIDE_OFFER_TIMEOUT_MS=15000
# how many nearest drivers to notify per batch
RIDE_BATCH_SIZE=3
# how many times to retry with a new batch before giving up
RIDE_MAX_RETRIES=3
# search radius in km
RIDE_SEARCH_RADIUS_KM=5
